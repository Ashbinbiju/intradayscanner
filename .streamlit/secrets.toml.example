# Copy to .streamlit/secrets.toml (git-ignored) or paste into the
# Streamlit Cloud "Secrets" box. Never commit the real file.

# Angel One. Only needed for symbols missing from the local candle cache.
# These grant full trading access -- restrict app viewers accordingly.
CLIENT_ID   = "<client id>"
PASSWORD    = "<mpin>"
TOTP_SECRET = "<base32 totp secret>"
API_KEY     = "<api key>"

# The screener API (intradayscreener.com) is public and needs no key.
