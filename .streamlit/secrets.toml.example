# Copy to .streamlit/secrets.toml (git-ignored) or paste into the
# Streamlit Cloud "Secrets" box. Never commit the real file.

# Angel One -- full trading access. Restrict app viewers accordingly.
CLIENT_ID   = "<client id>"
PASSWORD    = "<mpin>"
TOTP_SECRET = "<base32 totp secret>"
API_KEY     = "<api key>"

# Upstox -- market data only, cannot place orders.
UPSTOX_TOKEN = "<analytics token>"

# Preferred candle source; the other is the fallback.
DATA_SOURCE = "upstox"

# The screener API (intradayscreener.com) is public and needs no key.
