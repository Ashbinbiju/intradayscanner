# Copy to .streamlit/secrets.toml (git-ignored) or paste into the
# Streamlit Cloud "Secrets" box. Never commit the real file.

# --- Supabase -------------------------------------------------------------
# Use a read-only anon key here, NOT an sb_secret_ service-role key.
# The service-role key bypasses row-level security.
SUPABASE_URL = "https://<project>.supabase.co"
SUPABASE_KEY = "<anon key>"

# --- Angel One ------------------------------------------------------------
# Only needed for symbols missing from the local candle cache. These grant
# full trading access to the account -- do not put them on a public app.
CLIENT_ID   = "<client id>"
PASSWORD    = "<mpin>"
TOTP_SECRET = "<base32 totp secret>"
API_KEY     = "<api key>"
