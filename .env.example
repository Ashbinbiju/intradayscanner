# Copy to .env and fill in. .env is git-ignored.
# On Streamlit Cloud use the Secrets box instead (same key names).

# --- Angel One (full trading access -- treat as a password) ---
# Required for placing orders. Also a candle source.
CLIENT_ID=
PASSWORD=            # MPIN
TOTP_SECRET=         # base32 secret from authenticator setup
API_KEY=

# --- Upstox (market data only) ---
# An Analytics token. It cannot trade: the order endpoints reject it unless
# the request comes from a static IP registered on that account. Used as the
# candle source, with Angel behind it.
UPSTOX_TOKEN=

# Which candle source to try first: upstox | angel. The other stands in when
# the first fails. Upstox is the default because Angel's feed stops at 15:10
# for many symbols, dropping the bars the 15:15 square-off needs.
DATA_SOURCE=upstox

# The symbol universe comes from intradayscreener.com, which needs no key.
